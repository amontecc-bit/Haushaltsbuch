APP_NAME="Haushaltsbuch"
# Sichere Vorgabe für den Server. Lokal zum Entwickeln: APP_ENV=local und APP_DEBUG=true
# (zeigt Fehlerdetails im Browser – nie auf einem öffentlichen Server einschalten)
APP_ENV=production
APP_DEBUG=false
# Leer lassen = automatisch ermitteln (z.B. /Haushaltsbuch)
APP_BASE_URL=
# Öffentliche Adresse ohne Pfad (für Claude/MCP), z. B. https://haushalt.example.de – leer = aus der Anfrage
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=haushaltsbuch
DB_USER=root
DB_PASS=

# Optional: KI-Erkennung von Kassenbons (Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
