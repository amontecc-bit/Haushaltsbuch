{
    "name": "amontecc/haushaltsbuch",
    "description": "Haushaltsbuch-Web-App für die Familie",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "anthropic-ai/sdk": "^0.51.0",
        "guzzlehttp/guzzle": "^8.2",
        "smalot/pdfparser": "^2.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": { "sort-packages": true }
}
