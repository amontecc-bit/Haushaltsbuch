Options -Indexes
DirectoryIndex index.php
# Authorization-Header (Bearer-Token für Claude/MCP) an PHP weiterreichen – bei CGI/FastCGI (z. B. IONOS) fehlt er sonst
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Basis-URL selbst ermitteln statt RewriteBase: ohne sie hängen manche Hoster (z. B. IONOS)
# den physischen Pfad vor "index.php" → 500er bei allen Routen außer "/"
RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
RewriteRule .* - [E=BASE:%1]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ %{ENV:BASE}/index.php [L,QSA]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

AddType application/wasm .wasm
AddType text/javascript .mjs
<IfModule mod_mime.c>
    RemoveEncoding .gz
</IfModule>
<FilesMatch "\.traineddata\.gz$">
    <IfModule mod_headers.c>
        Header unset Content-Encoding
    </IfModule>
    ForceType application/octet-stream
</FilesMatch>
